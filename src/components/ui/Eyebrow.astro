---
// 12px / medium / uppercase / 0.1em tracking / Primary Blue. See CLAUDE.md "Type".
interface Props {
  class?: string;
  as?: 'div' | 'span' | 'p';
  /** 'blue-light' is the on-charcoal variant used inside the dark Guarantee section. */
  color?: 'blue' | 'blue-light';
}

const { class: className = '', as: Tag = 'div', color = 'blue' } = Astro.props;

const colorClass = color === 'blue-light' ? 'text-blue-light' : 'text-blue';
---

<Tag class:list={['text-xs font-medium uppercase tracking-widest', colorClass, className]}>
  <slot />
</Tag>
