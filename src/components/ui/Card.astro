---
// White or Light Gray fill, 1px border, 12px radius. No drop shadows. See CLAUDE.md "Components".
interface Props {
  bg?: 'white' | 'gray-light';
  as?: 'div' | 'li';
  class?: string;
}

const { bg = 'white', as: Tag = 'div', class: className = '' } = Astro.props;

const bgClass = bg === 'gray-light' ? 'bg-gray-light' : 'bg-white';
---

<Tag class:list={['rounded-card border border-border p-8', bgClass, className]}>
  <slot />
</Tag>
