---
const links = [
  { href: '/#method', label: 'The Method' },
  { href: '/#guarantee', label: 'Guarantee' },
  { href: '/#requirements', label: 'Requirements' },
  { href: '/#faq', label: 'FAQ' },
];
---

<footer class="border-t border-border bg-white px-6 py-12">
  <div class="mx-auto flex max-w-content flex-wrap items-center justify-between gap-6">
    <div class="flex flex-wrap items-center gap-6">
      <span class="text-lg font-bold tracking-[-0.02em] text-charcoal">TBM</span>
      <a href="mailto:ben@thebenmount.com" class="text-[15px] text-gray-muted hover:text-blue">
        ben@thebenmount.com
      </a>
    </div>
    <div class="flex flex-wrap gap-6">
      {
        links.map((link) => (
          <a href={link.href} class="text-[15px] text-gray-muted hover:text-blue">
            {link.label}
          </a>
        ))
      }
    </div>
    <div class="flex flex-wrap items-center gap-5">
      <span class="text-sm text-gray-muted">© 2026 TBM Ventures LLC</span>
      <a href="/privacy" class="text-sm text-gray-muted hover:text-blue">Privacy</a>
      <a href="/terms" class="text-sm text-gray-muted hover:text-blue">Terms</a>
    </div>
  </div>
</footer>
